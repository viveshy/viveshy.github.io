---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
	href: string;
	title: string;
	/** Omitted for undated collections such as Notes. */
	date?: Date;
	note?: string;
	/** Opens in a new tab and shows an outbound marker. */
	external?: boolean;
	/** Banner thumbnail. Omitted collections keep the plain text row. */
	heroImage?: ImageMetadata;
}

const { href, title, date, note, external = false, heroImage } = Astro.props;

// Where the date sits depends on whether the row carries a preview. With
// one, a right-hand date floats level with the title and detached from
// everything; below the text it reads as part of the entry. Without one,
// the row is a single line and the far right is the natural place.
const hasNote = Boolean(note) || Astro.slots.has('default');

// noopener is the security-relevant half: without it the opened page can
// reach back through window.opener. noreferrer keeps the referrer off.
const outbound = external
	? { target: '_blank', rel: 'noopener noreferrer' }
	: {};

// Note-carrying collections pass their rendered body through the slot
// instead of the `note` string.
// Astro.slots.has() is true even when the slot resolves to nothing —
// ListPage always passes children, and passes null when showNotes is off.
// Rendering it and checking the result is the only reliable test.
const slotted = Astro.slots.has('default') ? await Astro.slots.render('default') : '';
const hasSlottedNote = slotted.trim().length > 0;
---

<li class:list={['row', { 'row--thumb': heroImage }]}>
	{
		heroImage && (
			<a class="thumb" href={href} {...outbound} tabindex="-1" aria-hidden="true">
				{/* No densities: the banner is a vector, so a 2x variant is a
					    byte-identical duplicate. */}
					<Image src={heroImage} alt="" width={240} loading="lazy" />
			</a>
		)
	}
	<div class="body">
	<p class="line">
		<a href={href} {...outbound}>
			{title}
			{external && <span class="out" aria-label="opens in a new tab">↗</span>}
		</a>
	</p>
	{note && <p class="note">{note}</p>}
	{
		hasSlottedNote && (
			<div class="note" set:html={slotted} />
		)
	}
	{date && hasNote && <FormattedDate date={date} />}
	</div>
	{date && !hasNote && <FormattedDate date={date} />}
</li>

<style>
	/*
	 * [thumb] [text] [date] — the date is its own column so it sits at the
	 * true right edge of the row rather than the right edge of the text.
	 * `auto` on the last column keeps it as narrow as the date needs.
	 */
	.row {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0 1.25rem;
		align-items: start;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--border);
	}
	/*
	 * Rows with a banner become a two-column grid. The thumbnail is
	 * aria-hidden and tabindex=-1 — it duplicates the title link, so
	 * exposing it twice would just make the list slower to navigate with
	 * a screen reader or keyboard.
	 */
	.row--thumb {
		grid-template-columns: 104px 1fr auto;
	}
	.thumb {
		display: block;
		width: 104px;
		height: 68px;
		border-radius: 4px;
		overflow: hidden;
		border: 1px solid var(--border-light);
	}
	.thumb :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	@media (max-width: 560px) {
		.row--thumb {
			grid-template-columns: 68px 1fr auto;
		}
		.thumb {
			width: 68px;
			height: 46px;
		}
	}
	/*
	 * Title left, date right. `baseline` rather than `center` so the date
	 * sits on the title's baseline even when the title wraps to two lines.
	 */
	.line {
		margin: 0;
	}
	/* Monospace so dates form a clean right-hand column down the list. */
	/* Monospace either way, so dates stay a consistent voice. */
	:global(time) {
		font-family: var(--font-mono);
		color: var(--ink-faint);
		font-size: 0.8rem;
		white-space: nowrap;
	}
	/* Far right, level with the title's first line. */
	.row > :global(time) {
		padding-top: 0.15rem;
	}
	/* Below the preview, in the text column. */
	.body > :global(time) {
		display: block;
		margin-top: 0.5rem;
	}
	/* Two or three lines of preview, then clamp — long descriptions
	   otherwise make every row a different height. */
	.note {
		margin: 0.3rem 0 0;
		color: var(--ink-soft);
		font-size: 0.9rem;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.note :global(p) {
		margin: 0.25rem 0;
	}
	.out {
		color: var(--ink-soft);
		font-size: 0.8em;
		margin-left: 0.25em;
	}
</style>
