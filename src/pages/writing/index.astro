---
import { getCollection } from 'astro:content';
import ListPage from '../../layouts/ListPage.astro';
import { isPublished } from '../../lib/entries';

const entries = (await getCollection('writing')).filter((e) => isPublished(e));
---

<ListPage
	title="Writing"
	blurb="On AI and LLMs, engineering, and how software actually gets built."
	base="/writing"
	entries={entries}
/>
