---
import { getCollection } from 'astro:content';
import ListPage from '../../layouts/ListPage.astro';
import { isPublished } from '../../lib/entries';
import site from '../../data/site.yaml';

const entries = (await getCollection('papers')).filter((e) => isPublished(e));
---

{/* Sorted by readDate, newest first, but the date itself stays out of
    the UI — the order already carries it. */}
<ListPage
	title={site.sections.papers.title}
	blurb={site.sections.papers.blurb}
	base="/papers"
	entries={entries}
	linkField="driveUrl"
	dateField="readDate"
	showDate={false}
/>
