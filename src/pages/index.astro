---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import TeaserList from '../components/TeaserList.astro';
import { isPublished } from '../lib/entries';

const writing = (await getCollection('writing')).filter((e) => isPublished(e));
const notes = (await getCollection('notes')).filter((e) => isPublished(e));
const papers = (await getCollection('papers')).filter((e) => isPublished(e));
---

<BaseLayout wide>
	<section class="hero prose">
		<h1>Hey, I am Vivesh</h1>
		<p class="tagline">AI, LLMs, databases, and systems that scale.</p>

		<p>
			I'm a product-minded Senior AI Engineer with a background in backend
			engineering. I build AI products and infrastructure — AI Governance
			and Control, AI Observability, Inference Routing, and Agentic
			Systems — making LLMs more reliable, secure, and cost-effective.
		</p>
		<p>
			Most of my work sits around AI systems, backend architecture,
			databases, and the infrastructure needed to make things scale. I
			write about engineering here, and about what I learn along the way.
			<a href="/about/">More about me →</a>
		</p>

		<SocialLinks />
	</section>

	<TeaserList
		heading="Writing"
		blurb="Recent pieces."
		more="/writing/"
		moreLabel="All writings"
		base="/writing"
		entries={writing}
		limit={5}
	/>

	<TeaserList
		heading="Notes"
		blurb="Topics I am working through, edited over time."
		more="/notes/"
		moreLabel="All notes"
		base="/notes"
		entries={notes}
		limit={4}
	/>

	<TeaserList
		heading="Paper Drops"
		blurb="What I have been reading."
		more="/papers/"
		moreLabel="All papers"
		base="/papers"
		entries={papers}
		limit={4}
		linkField="driveUrl"
		dateField="readDate"
		showDate={false}
	/>
</BaseLayout>

<style>
	.hero h1 {
		margin-top: 0;
		font-weight: 700;
	}
	.tagline {
		color: var(--ink-soft);
		font-size: 1.15rem;
		margin-top: -0.5rem;
	}
</style>
